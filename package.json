{
	"author": "Jeremiah Lee",
	"description": "The website of Jeremiah Lee",
	"devDependencies": {
		"@11ty/eleventy": "^3.1.5",
		"@11ty/eleventy-plugin-handlebars": "^1.0.0",
		"@11ty/eleventy-plugin-rss": "^3.0.0",
		"@biomejs/biome": "^2.5.12",
		"@cloudflare/workers-types": "^5.20260908.1",
		"@tailwindcss/cli": "^4.3.3",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"moment": "^2.30.1",
		"tailwindcss": "^4.3.3"
	},
	"engines": {
		"node": ">= 20"
	},
	"keywords": [],
	"license": "UNLICENSED",
	"name": "www.jeremiahlee.com",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "npm run build:html && npm run build:css",
		"build:css": "npx @tailwindcss/cli --optimize -i css/style.css -o dist/soul-class-style-badass.css",
		"build:html": "npx @11ty/eleventy",
		"dev:css": "npx @tailwindcss/cli --watch -i css/style.css -o dist/soul-class-style-badass.css",
		"dev:serve": "ELEVENTY_ENV=development npx @11ty/eleventy --serve",
		"dev:cloudflare": "npx wrangler pages dev ./dist",
		"dev:spotify": "npx @tailwindcss/cli -i site/posts/failed-squad-goals/failed-squad-goals.source.css -o site/posts/failed-squad-goals/failed-squad-goals.compiled.css --watch",
		"build:spotify": "npx @tailwindcss/cli --optimize -i site/posts/failed-squad-goals/failed-squad-goals.source.css -o site/posts/failed-squad-goals/failed-squad-goals.compiled.css",
		"dev:burp": "npx @tailwindcss/cli -i site/posts/last-burp-of-hope/last-burp-of-hope.source.css -o site/posts/last-burp-of-hope/last-burp-of-hope.compiled.css --watch",
		"build:burp": "npx @tailwindcss/cli --optimize -i site/posts/last-burp-of-hope/last-burp-of-hope.source.css -o site/posts/last-burp-of-hope/last-burp-of-hope.compiled.css",
		"build:chat": "npx @tailwindcss/cli --optimize -i site/posts/after-chat-control/after-chat-control.source.css -o site/posts/after-chat-control/after-chat-control.compiled.css",
		"dev:raw": "npx @tailwindcss/cli -i site/posts/remote-async-work/remote-async-work.source.css -o site/posts/remote-async-work/remote-async-work.compiled.css --watch",
		"build:raw": "npx @tailwindcss/cli --optimize -i site/posts/remote-async-work/remote-async-work.source.css -o site/posts/remote-async-work/remote-async-work.compiled.css",
		"build:erg": "npx @tailwindcss/cli --optimize -i site/posts/lgbtq-erg/lgbtq-erg.source.css -o site/posts/lgbtq-erg/lgbtq-erg.compiled.css"
	},
	"version": "7.0.0",
	"allowScripts": {
		"@parcel/watcher@2.5.1": true,
		"fsevents@2.3.3": true
	}
}
