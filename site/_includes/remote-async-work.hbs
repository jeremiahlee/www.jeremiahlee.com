<!doctype html>
<html lang="en" dir="ltr">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{title}}</title>
{{> partial-head }}
	<link rel="canonical" href="https://www.jeremiahlee.com{{ page.url }}">
{{> partial-css }}
{{#if excerpt}}
	<meta name="description" content="{{ excerpt }}">
	<meta name="author" content="Jeremiah Lee">
	<meta property="article:published_time" content="{{ formatDate date 'iso' }}">
	{{#if updated}}
	<meta property="article:modified_time" content="{{ formatDate updated 'iso' }}">
	{{/if}}
	<meta property="og:title" content="{{ title }}">
	<meta property="og:type" content="article">
	<meta property="og:description" content="{{ excerpt }}">
	{{#if excerptImage}}
	<meta property="og:image" content="https://www.jeremiahlee.com{{ page.url }}{{ excerptImage }}">
	{{/if}}
{{/if}}
</head>
<body class="lg:p-0">

{{{ content }}}

<script type="application/ld+json">
{
	"@context": "http://schema.org/",
	"@type": "Article",
	"headline": "{{title}}",
	"description": "{{ excerpt }}",
	"author": {
		"@type": "Person",
		"name": "Jeremiah Lee"
	},
{{#if monetized}}
	"isAccessibleForFree": "False",
	"hasPart": {
		"@type": "WebPageElement",
		"isAccessibleForFree": "False",
		"cssSelector": ".exclusive"
	},
{{/if}}
	"datePublished": "{{ formatDate date 'iso' }}",
{{#if updated}}
	"dateModified": "{{formatDate updated 'iso'}}",
{{else}}
	"dateModified": "{{ formatDate date 'iso' }}",
{{/if}}
{{#if excerptImage}}
	"image": [
		"https://www.jeremiahlee.com{{ page.url }}{{ excerptImage }}"
	],
{{/if}}
	"copyrightYear": {{formatDate date 'year'}}
}
</script>

</body>
</html>
